<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.joutio</groupId>
    <artifactId>joutio-parent</artifactId>
    <version>3.2.0</version>
    <packaging>pom</packaging>

    <name>joutio-parent</name>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/joutio/joutio-sdk</url>
        </repository>
    </distributionManagement>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <joutio-sdk.version>3.2.0</joutio-sdk.version>

        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <spring-doc.version>2.8.17</spring-doc.version>

        <axon.version>4.13.1</axon.version>
        <axon-kafka-extension.version>4.12.1</axon-kafka-extension.version>
        <axon-springcloud-extension.version>4.12.1</axon-springcloud-extension.version>
        <!-- Alignées sur axonserver-connector-java (bus gRPC entre pods). -->
        <grpc.version>1.76.0</grpc.version>
        <protobuf.version>4.33.1</protobuf.version>
        <protobuf-maven-plugin.version>3.10.2</protobuf-maven-plugin.version>
        <db-scheduler.version>16.12.0</db-scheduler.version>

        <commons-text.version>1.15.0</commons-text.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-collections4.version>4.5.0</commons-collections4.version>

        <lombok.version>1.18.46</lombok.version>

        <postgresql.version>42.7.12</postgresql.version>

        <flyway.version>13.3.0</flyway.version>
        <slf4j.version>2.0.18</slf4j.version>

        <!-- Correctifs de sécurité (scan Trivy du 2026-11-20). Spring Boot 3.5 n'a plus de patch : ces propriétés
             surchargent les versions qu'il gère (le parent les déclare), les autres sont fixées plus bas. -->
        <tomcat.version>10.1.62</tomcat.version>
        <netty.version>4.1.141.Final</netty.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <httpcore5.version>5.4.4</httpcore5.version>
        <jackson3.version>3.1.8</jackson3.version>
        <bouncycastle.version>1.87</bouncycastle.version>
        <jose4j.version>0.9.7</jose4j.version>
        <guava.version>33.8.0-android</guava.version>
        <lz4-java.version>1.11.4</lz4-java.version>
        <snappy-java.version>1.1.10.12</snappy-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson 3 (Flyway) : hors du BOM Spring Boot 3.5. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.axonframework</groupId>
                <artifactId>axon-bom</artifactId>
                <version>${axon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Extension Axon Kafka -->
            <dependency>
                <groupId>org.axonframework.extensions.kafka</groupId>
                <artifactId>axon-kafka</artifactId>
                <version>${axon-kafka-extension.version}</version>
            </dependency>
            <dependency>
                <groupId>org.axonframework.extensions.kafka</groupId>
                <artifactId>axon-kafka-spring-boot-autoconfigure</artifactId>
                <version>${axon-kafka-extension.version}</version>
            </dependency>

            <!-- Extension Axon Spring Cloud -->
            <dependency>
                <groupId>org.axonframework.extensions.springcloud</groupId>
                <artifactId>axon-springcloud</artifactId>
                <version>${axon-springcloud-extension.version}</version>
            </dependency>
            <dependency>
                <groupId>org.axonframework.extensions.springcloud</groupId>
                <artifactId>axon-springcloud-spring-boot-autoconfigure</artifactId>
                <version>${axon-springcloud-extension.version}</version>
            </dependency>

            <!-- DB Scheduler (deadlines persistantes) -->
            <dependency>
                <groupId>com.github.kagkarlsson</groupId>
                <artifactId>db-scheduler-spring-boot-starter</artifactId>
                <version>${db-scheduler.version}</version>
            </dependency>

            <!-- Transitives corrigées : client Kubernetes (BouncyCastle, jose4j), gRPC d'Axon Server (Guava),
                 kafka-clients (lz4, snappy). -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bitbucket.b_c</groupId>
                <artifactId>jose4j</artifactId>
                <version>${jose4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${spring-doc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${spring-doc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>${commons-collections4.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${commons-text.version}</version>
            </dependency>


            <!-- Artefacts SDK Joutio -->
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-microservice-core</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-microservice-autoconfigure</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-microservice-starter</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-axon-grpc</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-inprocess</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-axon-deadline</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-axon-autoconfigure</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-axon-starter</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.joutio</groupId>
                <artifactId>joutio-axon-test</artifactId>
                <version>${joutio-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.github.ascopes</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <!-- Génère META-INF/build-info.properties dans chaque service (hérité) :
                             version réelle exposée par BuildProperties (tags métriques `version`,
                             snapshots de l'agent console) au lieu de `unknown`. -->
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

